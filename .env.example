# ── Alpaca paper-trading credentials ─────────────────────────────────────────
# Copy this file to .env and fill in your actual keys.
# NEVER commit .env to git — it is already in .gitignore.
#
# Get or rotate your keys at:
#   https://app.alpaca.markets/paper-trading/overview → API Keys
#
ALPACA_API_KEY=REPLACE_WITH_YOUR_KEY
ALPACA_SECRET_KEY=REPLACE_WITH_YOUR_SECRET

# Set to "true" for paper trading (default), "false" for live trading.
# Always verify the strategy on paper first!
ALPACA_PAPER=true
